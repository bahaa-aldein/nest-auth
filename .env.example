# Settings for the production stack (compose.production.yaml). Copy to .env, which git ignores.
# Password of the MongoDB root user (the user name is root). Use a long random value without
# special characters, because it is part of the connection string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_PASSWORD=
# Optional: the port of the web container on your PC (default 8080)
# HTTP_PORT=8080
