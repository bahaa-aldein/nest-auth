# Copy to .env and fill in. The app refuses to start if a required value is missing or invalid.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nest-auth
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Alternative to JWT_SECRET for production: the path of a file that holds the secret,
# for example a Docker secret. Set JWT_SECRET or JWT_SECRET_FILE, not both.
# JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_EXPIRES_IN=15m
# Browser origin allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Optional. Keeps the rate-limit counters in Redis, so several api copies share them.
# Without it, each copy counts in its own memory, which is fine for one copy.
# REDIS_URL=redis://localhost:6379
